# Never let a real environment file into the build context.
.env
.env.*
!.env.example

node_modules
dist
coverage

.git
.github
.gitignore

# Tests and their fixtures are excluded from the build entirely.
src/**/*.test.ts
src/test
vitest.config.ts

README.md
Dockerfile
.dockerignore
docker-compose.yml

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
