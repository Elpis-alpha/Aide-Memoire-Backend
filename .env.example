# ---- Runtime ----
NODE_ENV=
PORT=
LOG_LEVEL=

# ---- Database ----
# Dev database on the shared cluster (Phase 0.5) — never the production one.
MONGODB_URL=

# ---- Identity ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL_DAYS=
# Leave EMPTY for the same-origin deploy (the default): the cookie is then
# host-only, which is what you want. Set it to .yourdomain.com ONLY in the
# cross-origin fallback, where the browser calls the API subdomain directly.
COOKIE_DOMAIN=

# ---- Public identity ----
HOST=
SITE_NAME=
FRONT_END_LOCATION=
CORS_ORIGINS=

# ---- Mail (Gmail HTTPS API; OVERSEER_* renamed to MAIL_*) ----
EMAIL_ADDRESS=
EMAIL_NAME=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=

# ---- Media ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# ---- Infrastructure ----
# 1 behind nginx so rate limiting sees real client IPs; 0 when run directly.
TRUST_PROXY=
# Unset locally: rate limiting falls back to in-process counters.
# REDIS_URL="redis://127.0.0.1:6379"
